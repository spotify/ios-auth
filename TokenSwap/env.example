# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Encryption secret for refresh tokens
# You can generate a random string with: `openssl rand -base64 32`
ENCRYPTION_SECRET=your_encryption_secret_here

# OAuth callback URL (must match the one in Spotify Dashboard)
CLIENT_CALLBACK_URL=https://your-callback-url.com

